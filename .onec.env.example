export ONEC_USERNAME=onec
export ONEC_PASSWORD=onec
export ONEC_VERSION=8.3.18.1520
export EDT_VERSION=2021.2.7
export COVERAGE41C_VERSION=''

export DOCKER_REGISTRY_URL=docker-registry:5000
export DOCKER_LOGIN=login
export DOCKER_PASSWORD=password

export EXECUTOR_VERSION=3.0.2.2
export DEV1C_EXECUTOR_API_KEY=YOUR_API_KEY_HERE

export DOCKER_SYSTEM_PRUNE=false
export NO_CACHE=false

# PostgreSQL версия от 1С (для Dockerfile.1c)
# Доступные версии: https://releases.1c.ru/project/AddCompPostgre
export POSTGRES_VERSION=17.5-11.1C

# PostgreSQL настройки
export POSTGRES_DB=postgres
export POSTGRES_USER=postgres
export POSTGRES_PASSWORD=changeme_strong_password
export POSTGRES_PORT=5432
export POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# pgAdmin настройки
export PGADMIN_DEFAULT_EMAIL=admin@example.com
export PGADMIN_DEFAULT_PASSWORD=admin_strong_password
export PGADMIN_PORT=5050
